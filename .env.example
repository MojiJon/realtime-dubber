# Copy this file to ".env" (same folder) and fill in your real values.
# The ".env" file is loaded automatically by config.py -- you won't need to
# set these in the terminal anymore.

GEMINI_API_KEY=your-real-key-here

# Optional: only set this if requests to Google's API are failing/timing out
# due to network restrictions. Point it at your local proxy client.
# HTTPS_PROXY=http://127.0.0.1:10809
